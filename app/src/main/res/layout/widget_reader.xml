<?xml version="1.0" encoding="utf-8"?>
<!-- The reading widget: where the reading stopped; a tap opens the reader at that verse -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:padding="3dp">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_night" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/rd_title"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ورد القراءة"
            android:textColor="#F2CF8A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rd_line"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rd_sub"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
