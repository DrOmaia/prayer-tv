<?xml version="1.0" encoding="utf-8"?>
<!-- The weather of one city, small (2x2): the weather now, its temperature and today's highest / lowest, nothing else;
     the city's name takes the icon's place while there is nothing to show for «now». A tap opens its weather in the app -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_night" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/wx_icon0"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wx_name0"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wx_temp0"
            style="@style/WxTemp"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/wx_hl0"
            style="@style/WxTemp"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textStyle="normal" />
    </LinearLayout>
</FrameLayout>
