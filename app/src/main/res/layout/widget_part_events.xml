<?xml version="1.0" encoding="utf-8"?>
<!-- «مواقيت اليوم»: the coming occasions and the days left, in turn; placed right, centre or left -->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ev_flip"
    android:layoutDirection="rtl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:autoStart="true"
    android:flipInterval="5000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">
    <LinearLayout
        android:id="@+id/ev_box0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ev0n"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2CF8A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ev0d"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ev_box1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ev1n"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2CF8A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ev1d"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ev_box2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ev2n"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2CF8A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ev2d"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="17sp" />
    </LinearLayout>
</ViewFlipper>
