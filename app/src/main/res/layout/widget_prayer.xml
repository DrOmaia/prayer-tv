<?xml version="1.0" encoding="utf-8"?>
<!-- Today's prayer times on a card whose colour follows the time of day (dawn, day, Asr, sunset, night) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <!-- background (colour of the time or dark), its transparency is chosen in the app's settings -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_night" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- next prayer, the coming occasions and the time left -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <!-- three places (right, centre, left): the app chooses which part goes where -->
        <FrameLayout
            android:id="@+id/slot_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/slot_c"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp" />

        <FrameLayout
            android:id="@+id/slot_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- progress from the last time to the next -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:indeterminate="false"
        android:max="1000"
        android:progressDrawable="@drawable/widget_bar" />

    <!-- the six times; the current one in a slowly blinking frame -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layoutDirection="rtl"
        android:orientation="horizontal">
        <FrameLayout style="@style/WidgetCell">
            <ViewFlipper android:id="@+id/now0" style="@style/WidgetNow">
                <ImageView android:id="@+id/nowf0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_now" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
            </ViewFlipper>
            <LinearLayout android:id="@+id/col0" style="@style/WidgetCol" android:layout_width="match_parent">
                <TextView android:id="@+id/n0" style="@style/WidgetName" />
                <TextView android:id="@+id/t0" style="@style/WidgetTime" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout style="@style/WidgetCell">
            <ViewFlipper android:id="@+id/now1" style="@style/WidgetNow">
                <ImageView android:id="@+id/nowf1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_now" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
            </ViewFlipper>
            <LinearLayout android:id="@+id/col1" style="@style/WidgetCol" android:layout_width="match_parent">
                <TextView android:id="@+id/n1" style="@style/WidgetName" />
                <TextView android:id="@+id/t1" style="@style/WidgetTime" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout style="@style/WidgetCell">
            <ViewFlipper android:id="@+id/now2" style="@style/WidgetNow">
                <ImageView android:id="@+id/nowf2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_now" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
            </ViewFlipper>
            <LinearLayout android:id="@+id/col2" style="@style/WidgetCol" android:layout_width="match_parent">
                <TextView android:id="@+id/n2" style="@style/WidgetName" />
                <TextView android:id="@+id/t2" style="@style/WidgetTime" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout style="@style/WidgetCell">
            <ViewFlipper android:id="@+id/now3" style="@style/WidgetNow">
                <ImageView android:id="@+id/nowf3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_now" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
            </ViewFlipper>
            <LinearLayout android:id="@+id/col3" style="@style/WidgetCol" android:layout_width="match_parent">
                <TextView android:id="@+id/n3" style="@style/WidgetName" />
                <TextView android:id="@+id/t3" style="@style/WidgetTime" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout style="@style/WidgetCell">
            <ViewFlipper android:id="@+id/now4" style="@style/WidgetNow">
                <ImageView android:id="@+id/nowf4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_now" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
            </ViewFlipper>
            <LinearLayout android:id="@+id/col4" style="@style/WidgetCol" android:layout_width="match_parent">
                <TextView android:id="@+id/n4" style="@style/WidgetName" />
                <TextView android:id="@+id/t4" style="@style/WidgetTime" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout style="@style/WidgetCell">
            <ViewFlipper android:id="@+id/now5" style="@style/WidgetNow">
                <ImageView android:id="@+id/nowf5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_now" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" />
            </ViewFlipper>
            <LinearLayout android:id="@+id/col5" style="@style/WidgetCol" android:layout_width="match_parent">
                <TextView android:id="@+id/n5" style="@style/WidgetName" />
                <TextView android:id="@+id/t5" style="@style/WidgetTime" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- a line that changes every 8 seconds: the supplication of the day, then the time's dhikr / iftar / an occasion -->
    <ViewFlipper
        android:id="@+id/flip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:autoStart="true"
        android:flipInterval="8000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <TextView
            android:id="@+id/dua"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/info_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/info_label"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center"
                android:textSize="13sp" />

            <Chronometer
                android:id="@+id/info_chrono"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#F2CF8A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ViewFlipper>

    <!-- the Gregorian date on the right, the Hijri date with the moon on the left -->
    <LinearLayout
        android:id="@+id/foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_foot"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="5dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/greg"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/moon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/hijri"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
