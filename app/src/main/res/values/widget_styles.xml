<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetText">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:shadowColor">#B3000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
    </style>
    <style name="WidgetCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
    <!-- a time's cell: its column over a frame that blinks while it is the current prayer -->
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="WidgetNow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:visibility">gone</item>
        <item name="android:autoStart">true</item>
        <item name="android:flipInterval">4000</item>
        <item name="android:inAnimation">@anim/now_in</item>
        <item name="android:outAnimation">@anim/now_out</item>
    </style>
    <style name="WidgetName" parent="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="WidgetTime" parent="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- month widget -->
    <style name="MonthCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="MonthH" parent="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="MonthG" parent="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9sp</item>
        <item name="android:alpha">0.75</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="MonthK" parent="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">8sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="MonthWd" parent="WidgetText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:alpha">0.75</item>
        <item name="android:textSize">10sp</item>
    </style>
    <!-- weather widgets: a temperature is always written left to right (a minus sign stays before its number) -->
    <style name="WxTemp" parent="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- weather widgets: one of the coming days (its short name, the day's weather, highest over lowest) -->
    <style name="WxDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="WxDayName" parent="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:alpha">0.85</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="WxDayIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
    </style>
    <style name="WxDayHi" parent="WxTemp">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="WxDayLo" parent="WxTemp">
        <item name="android:alpha">0.75</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
